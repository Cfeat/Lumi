{
  "name": "lumi-desktop-pet",
  "productName": "Lumi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:3000 && cross-env VITE_DEV_SERVER_URL=http://localhost:3000 electron .\"",
    "electron:start": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "gen:icon": "node scripts/gen-icon.cjs"
  },
  "build": {
    "appId": "com.lumi.desktoppet",
    "productName": "Lumi",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "public/config",
        "to": "config"
      },
      {
        "from": "assets/icon.png",
        "to": "assets/icon.png"
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "portable": {
      "artifactName": "Lumi-${version}-portable.exe"
    }
  },
  "dependencies": {
    "framer-motion": "^12.29.2",
    "lucide-react": "^0.563.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wait-on": "^9.1.0"
  }
}
